# Local development database (embedded-postgres, see scripts/db.mjs).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/pickem_dev

# Base URL the app uses for absolute links (email verification, review alerts).
APP_URL=http://localhost:3000

# Set to "true" when serving over HTTPS (staging/production); keeps the
# session cookie Secure. Must be "false" for plain-http local dev.
SESSION_COOKIE_SECURE=false

# Never set to "production" for local dev.
NODE_ENV=development
